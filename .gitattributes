# Keep GitHub language statistics focused on the current PySide6 application.
*.py linguist-language=Python
*.R linguist-vendored
*.r linguist-vendored
*.js linguist-vendored
*.json linguist-vendored

assets/** linguist-vendored
docs/** linguist-documentation
packaging/** linguist-vendored
scripts/*.bat linguist-vendored
scripts/*.ps1 linguist-vendored

# PDFs written by ReportLab are pure ASCII; without this, Windows checkouts convert
# their line endings to CRLF and corrupt the internal byte offsets.
*.pdf binary
